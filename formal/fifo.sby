[tasks]
prove: default
cover

[options]
prove: mode prove
cover: mode cover
prove: depth 12
cover: depth 12

[engines]
prove: smtbmc
prove: abc pdr
cover: smtbmc

[script]
plugin -i slang.so
read_slang --std 1800-2017 --top cc_fifo_formal -F formal.flist
prep -top cc_fifo_formal
async2sync
dffunmap

[files]
build/formal.flist
