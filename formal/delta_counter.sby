# Proof and bounded-cover configuration for all cc_delta_counter
# widths 1 through 8 and both overflow modes.  delta_i is unconstrained in
# the harness.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 40
cover: mode cover
cover: depth 16

[engines]
smtbmc

[script]
plugin -i slang.so
read_slang --std 1800-2017 --top cc_delta_counter_formal -F formal.flist
prep -top cc_delta_counter_formal
async2sync
dffunmap

[files]
build/formal.flist
